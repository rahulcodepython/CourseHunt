# ==============================================================================
# Server Configuration (Go Backend)
# ==============================================================================
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://coursehunt.localhost:3000,http://admin.coursehunt.localhost:3000,http://api.coursehunt.localhost:8080

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coursehunt
POSTGRES_PORT=5432
POSTGRES_IMAGE=postgres:latest
POSTGRES_CONTAINER_NAME=coursehunt-postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coursehunt?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5

# ==============================================================================
# Cache Configuration (Redis)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=coursehunt-redis

# ==============================================================================
# Authentication & JWT Configuration
# ==============================================================================
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_COOKIE_NAME=better-auth.session_token

JWKS_URL=http://localhost:3000/api/auth/jwks

JWT_SECRET=your_jwt_secret_here
JWT_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
COOKIE_DOMAIN=.localhost
COOKIE_SECURE=false
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/

# ==============================================================================
# Third-Party Services Configuration
# ==============================================================================
# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# MinIO Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=coursehunt
MINIO_BASE_URL=http://localhost:9000/coursehunt
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=minio/minio:latest
MINIO_CONTAINER_NAME=coursehunt-minio

# WhoDB GUI Configuration
WHODB_PORT=8085
WHODB_IMAGE=clidey/whodb:latest
WHODB_CONTAINER_NAME=coursehunt-whodb

# Mailpit (local SMTP catch-all for student OTP emails) — web UI at
# http://localhost:8025, no real inbox needed for local dev.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_IMAGE=axllent/mailpit:latest
MAILPIT_CONTAINER_NAME=coursehunt-mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="CourseHunt <no-reply@coursehunt.localhost>"

# Backend Container Configuration
BACKEND_CONTAINER_NAME=coursehunt-backend

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ==============================================================================
# Docker Container Overrides
# ==============================================================================
DOCKER_REDIS_HOST=redis
DOCKER_MINIO_ENDPOINT=minio:9000
DOCKER_JWKS_URL=http://host.docker.internal:3000/api/auth/jwks
DOCKER_DATABASE_URL=postgres://postgres:postgres@postgres:5432/coursehunt?sslmode=disable

# ==============================================================================
# Frontend Applications Configuration (Next.js)
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COOKIE_DOMAIN=localhost
