# ==============================================================================
# CourseHunt — DEVELOPMENT environment  (copy to .env)
# ==============================================================================
# Same keys, same order as .env.production.example — only the values differ.
# `bun run dev` loads this one file for both apps (backend + frontend).
# Start local Postgres, Redis and MinIO first: `bun run deps:up`.

# --- App URLs -------------------------------------------------------------------
ENVIRONMENT=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Browser origins the API (and /api/auth preflight) accept. Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database -------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coursehunt?sslmode=disable

# --- Redis (optional — leave empty to run without it) -------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth -----------------------------------------------------------------------
# openssl rand -hex 32
BETTER_AUTH_SECRET=dev_only_change_me
JWKS_URL=http://localhost:3000/api/auth/jwks
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# --- File storage (optional — leave MINIO_ENDPOINT empty to disable uploads) ----
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=coursehunt
MINIO_BASE_URL=http://localhost:9000/coursehunt
MINIO_PUBLIC_BUCKET=coursehunt
MINIO_PUBLIC_BASE_URL=http://localhost:9000/coursehunt

# --- Payments (Razorpay test mode) ----------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TAX_PERCENT=18

# --- Email (Resend; without a key, login codes are only logged, not sent) ------
RESEND_API_KEY=
EMAIL_FROM="CourseHunt <onboarding@resend.dev>"


# ==============================================================================
# Local Docker only (docker-compose.yml) — not used in production
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coursehunt
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
