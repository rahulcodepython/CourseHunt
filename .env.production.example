# ==============================================================================
# Production deploy checklist
# ==============================================================================
# This is NOT a standalone env file — it's the subset of .env.example whose
# defaults are only safe for local dev and MUST be overridden before running
# `docker compose -f docker-compose.yml up -d` (the production base, no
# override.yml) on a VPS. Copy .env.example to .env first, then apply every
# value below on top of it.

# Public domain this deploy is reachable at (DNS A/AAAA record already
# pointing at the VPS) and a real email for Let's Encrypt notices.
DOMAIN=coursehunt.example.com
ACME_EMAIL=ops@example.com

# Strong, unique secrets — never reuse the dev placeholders.
BETTER_AUTH_SECRET=
JWT_SECRET=

# Real cookie/CORS scoping for the deployed domain — the dev defaults
# (localhost, COOKIE_SECURE=false) allow non-HTTPS cookies and any localhost
# origin, which is unsafe once this is reachable from the internet.
COOKIE_DOMAIN=.coursehunt.example.com
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://coursehunt.example.com
BETTER_AUTH_URL=https://coursehunt.example.com
NEXT_PUBLIC_API_URL=https://coursehunt.example.com
NEXT_PUBLIC_APP_URL=https://coursehunt.example.com
NEXT_PUBLIC_COOKIE_DOMAIN=coursehunt.example.com

# Postgres/MinIO credentials — replace the dev postgres/postgres and
# minioadmin/minioadmin defaults.
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
MINIO_BASE_URL=https://coursehunt.example.com/coursehunt

# Redis auth — docker-compose.yml's redis service runs with --requirepass
# and refuses to start with this empty (unlike local dev, which drops that
# flag via docker-compose.dev.yml).
REDIS_PASSWORD=

# Real transactional email — mailpit (the local SMTP catch-all) only exists
# in docker-compose.dev.yml and is never part of a production deploy,
# so OTP/notification emails need an actual SMTP relay here.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM="CourseHunt <no-reply@coursehunt.example.com>"

# Google OAuth callback for the real domain.
GOOGLE_CALLBACK_URL=https://coursehunt.example.com/api/auth/callback/google

# Live Razorpay keys (the dev defaults are blank/test).
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
