# ==============================================================================
# CourseHunt Production Deployment Environment Manifest
# ==============================================================================
# This template defines production environment variables for a single-domain
# deployment behind a Traefik edge reverse proxy (e.g. https://coursehunt.com).
# Copy this file to .env and set all passwords, secrets, and provider keys.

# ==============================================================================
# 1. Domain & Network Edge Infrastructure
# ==============================================================================
DOMAIN=coursehunt.com
ACME_EMAIL=admin@coursehunt.com
ENVIRONMENT=production
LOG_LEVEL=info

# ==============================================================================
# 2. Web Frontend (Next.js 16)
# ==============================================================================
PORT=3000
NEXT_PUBLIC_APP_URL=https://coursehunt.com
NEXT_PUBLIC_API_URL=https://coursehunt.com/api
NEXT_PUBLIC_COOKIE_DOMAIN=.coursehunt.com

# ==============================================================================
# 3. Authentication & Security
# ==============================================================================
# Generate 64-character random hex: `openssl rand -hex 32`
BETTER_AUTH_SECRET=REPLACE_WITH_HEX_64_CHAR_SECRET
BETTER_AUTH_URL=https://coursehunt.com
JWT_SECRET=REPLACE_WITH_HEX_64_CHAR_SECRET
JWKS_URL=http://web:3000/api/auth/jwks
AUTH_COOKIE_NAME=access_token
COOKIE_DOMAIN=.coursehunt.com
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://coursehunt.com
REQUEST_TIMEOUT_SEC=30

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://coursehunt.com/api/auth/callback/google

# ==============================================================================
# 4. PostgreSQL 16 Database & Connection Pool
# ==============================================================================
POSTGRES_USER=coursehunt_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_DB=coursehunt_prod
POSTGRES_PORT=5432
DATABASE_URL=postgres://coursehunt_prod_user:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/coursehunt_prod?sslmode=disable
DOCKER_DATABASE_URL=postgres://coursehunt_prod_user:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/coursehunt_prod?sslmode=disable

# High-Performance Pool Sizing
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=5
DB_CONN_MAX_IDLE_TIME=3
DB_STATEMENT_TIMEOUT_SEC=15

# ==============================================================================
# 5. Redis In-Memory Cache & Token Bucket
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD
REDIS_DB=0
DOCKER_REDIS_HOST=redis

# ==============================================================================
# 6. MinIO / S3 Object Storage (Dual Bucket Architecture)
# ==============================================================================
MINIO_ENDPOINT=minio:9000
DOCKER_MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=coursehunt-private
MINIO_PUBLIC_BUCKET=coursehunt-public
MINIO_BASE_URL=https://coursehunt.com/coursehunt-private
MINIO_SECURE=true

# ==============================================================================
# 7. Payment Gateway (Razorpay Live)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
TAX_PERCENT=18

# ==============================================================================
# 8. Centralized Logging (Grafana Loki)
# ==============================================================================
LOKI_URL=http://loki:3100
LOKI_BATCH_SIZE=100
LOKI_BATCH_WAIT_MS=1000

# ==============================================================================
# 9. Transactional SMTP Mailer Engine
# ==============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxx
SMTP_FROM="CourseHunt <no-reply@coursehunt.com>"
SMTP_SECURE=false
