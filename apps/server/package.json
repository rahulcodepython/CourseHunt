{
  "name": "@coursehunt/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/server",
    "migrate-up": "migrate -path internals/migrations -database \"$DATABASE_URL\" up",
    "migrate-down": "migrate -path internals/migrations -database \"$DATABASE_URL\" down 1",
    "seed": "go run ./cmd/seed",
    "flush": "go run ./cmd/seed flush"
  }
}
